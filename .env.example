APP_NAME="Monera Art"
APP_ENV=local
# Generate with `php artisan key:generate`. APP_KEY decrypts every customer
# address in the database and BLIND_INDEX_KEY is what makes them findable.
# Keep both in a password manager, and never in the same place as a backup.
APP_KEY=
BLIND_INDEX_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moneraart
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Monera Art ────────────────────────────────────────────────────────
# These are fallbacks only. Settings edited in the admin UI take
# precedence — see docs/implementation_plan.md §3.2.

ADMIN_PATH=admin

# Payments. Sandbox and live are separate so a mis-set mode cannot
# reach the wrong API with the wrong secret.
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_BRAND_NAME="Monera Art"

# Delivery
DOWNLOAD_EXPIRY_HOURS=72
DOWNLOAD_FREE_EXPIRY_HOURS=24
DOWNLOAD_MAX_DOWNLOADS=5
DOWNLOAD_PRESIGNED_TTL=60

# Storage: local | r2 | s3
# A fallback for the first boot only. Set this from Storage in the admin
# instead, where the credentials are tested before they are saved. The disk
# is recorded per file, so switching never strands what is already uploaded.
STORE_STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Store
STORE_SUPPORT_EMAIL=
STORE_CURRENCY=USD
STORE_DEFAULT_LOCALE=en
STORE_MINIMUM_PRICE_CENTS=199
